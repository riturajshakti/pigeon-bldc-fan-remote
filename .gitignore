# Widget Preview related
.widget_preview/

# APKs are large binaries, not source. The outputs/ folder itself is tracked
# so its index.html (the Cloudflare Pages download page) stays in the repo.
*.apk
*.aab

# Local signing material - never commit these.
key.properties
*.jks
*.keystore
