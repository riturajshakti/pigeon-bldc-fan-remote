<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/t_widget_arc"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:src="@drawable/widget_t_arc_1"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/t_widget_boost"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_marginStart="87dp"
            android:layout_marginTop="87dp"
            android:background="@drawable/widget_t_boost"
            android:src="@drawable/ic_w_t_boost"
            android:scaleType="fitCenter"
            android:padding="22dp"
            android:contentDescription="@string/widget_boost"/>

        <TextView
            android:id="@+id/t_widget_s1"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginStart="34dp"
            android:layout_marginTop="165dp"
            android:background="@drawable/widget_t_node"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/widget_t_stroke"
            android:textSize="26sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/t_widget_s2"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/widget_t_node"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/widget_t_stroke"
            android:textSize="26sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/t_widget_s3"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginStart="99dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_t_node"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/widget_t_stroke"
            android:textSize="26sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/t_widget_s4"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginStart="185dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/widget_t_node"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/widget_t_stroke"
            android:textSize="26sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/t_widget_s5"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginStart="165dp"
            android:layout_marginTop="165dp"
            android:background="@drawable/widget_t_node"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/widget_t_stroke"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/t_widget_power"
            android:layout_width="61dp"
            android:layout_height="61dp"
            android:layout_marginStart="100dp"
            android:layout_marginTop="192dp"
            android:background="@drawable/widget_t_node_power"
            android:src="@drawable/ic_w_t_power"
            android:scaleType="fitCenter"
            android:padding="13dp"
            android:contentDescription="@string/widget_power"/>
    </RelativeLayout>
</FrameLayout>
