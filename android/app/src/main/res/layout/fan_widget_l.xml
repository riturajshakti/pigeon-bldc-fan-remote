<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <RelativeLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/widget_arc"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/widget_arc_1"
            android:scaleType="fitCenter"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/widget_boost"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="67dp"
            android:layout_marginTop="67dp"
            android:background="@drawable/widget_boost"
            android:src="@drawable/ic_w_boost"
            android:scaleType="fitCenter"
            android:padding="17dp"
            android:contentDescription="@string/widget_boost"/>

        <TextView
            android:id="@+id/widget_s1"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="26dp"
            android:layout_marginTop="127dp"
            android:background="@drawable/widget_node"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_s2"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="11dp"
            android:layout_marginTop="49dp"
            android:background="@drawable/widget_node"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_s3"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="76dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_node"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_s4"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="142dp"
            android:layout_marginTop="49dp"
            android:background="@drawable/widget_node"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/widget_s5"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="127dp"
            android:layout_marginTop="127dp"
            android:background="@drawable/widget_node"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/widget_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/widget_power"
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:layout_marginStart="76dp"
            android:layout_marginTop="148dp"
            android:background="@drawable/widget_node_power"
            android:src="@drawable/ic_w_power"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:contentDescription="@string/widget_power"/>
    </RelativeLayout>
</FrameLayout>
